# Application OAuth2/OpenID Connect "Confidentielle" à créer dans Authentik
# (auth.funkysayu.fr), avec cette redirect URI enregistrée telle quelle :
#   https://<domaine-du-site>/api/auth/callback

# URL racine de l'issuer Authentik, ex :
# https://auth.funkysayu.fr/application/o/chenes-localisation/
AUTHENTIK_ISSUER=

AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=

# Doit être identique à l'URI enregistrée côté Authentik (schéma https inclus).
AUTHENTIK_REDIRECT_URI=https://<domaine-du-site>/api/auth/callback

# DÉVELOPPEMENT UNIQUEMENT — ne jamais définir en production. Remplace Authentik
# par une connexion factice : "Connexion" pose un simple cookie local, et les
# variables AUTHENTIK_* ci-dessus deviennent facultatives.
# AUTH_DEV_MODE=1
